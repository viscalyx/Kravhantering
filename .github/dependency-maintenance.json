{
  "schemaVersion": 1,
  "deferrals": [],
  "dependabotExclusions": [],
  "units": [
    {
      "id": "npm-root",
      "kind": "npm-package",
      "path": ".",
      "lane": "dependabot",
      "ecosystem": "npm",
      "directory": "/"
    },
    {
      "id": "npm-hsa-directory-mock",
      "kind": "npm-package",
      "path": "containers/hsa-directory-mock",
      "lane": "dependabot",
      "ecosystem": "npm",
      "directory": "/containers/hsa-directory-mock"
    },
    {
      "id": "npm-hsa-person-lookup-adapter",
      "kind": "npm-package",
      "path": "containers/hsa-person-lookup-adapter",
      "lane": "dependabot",
      "ecosystem": "npm",
      "directory": "/containers/hsa-person-lookup-adapter"
    },
    {
      "id": "npm-hsa-mtls-provisioner",
      "kind": "npm-package",
      "path": "containers/hsa-mtls-provisioner",
      "lane": "dependabot",
      "ecosystem": "npm",
      "directory": "/containers/hsa-mtls-provisioner"
    },
    {
      "id": "npm-toolchain",
      "kind": "npm-toolchain",
      "lane": "issue",
      "detector": "npm",
      "skill": "resolve-dependency-drift"
    },
    {
      "id": "lychee-toolchain",
      "kind": "release-toolchain",
      "lane": "issue",
      "detector": "lychee",
      "skill": "resolve-dependency-drift",
      "repository": "lycheeverse/lychee",
      "paths": [
        ".devcontainer/Dockerfile",
        "scripts/azure-dev/templates/bootstrap-host.sh",
        ".github/workflows/quality-checks.yml",
        "tests/unit/github-actions-workflow-security.test.ts"
      ]
    },
    {
      "id": "github-actions",
      "kind": "github-actions",
      "lane": "dependabot",
      "ecosystem": "github-actions",
      "directory": "/"
    },
    {
      "id": "devcontainer-features",
      "kind": "devcontainer-features",
      "lane": "dependabot",
      "ecosystem": "devcontainers",
      "directory": "/"
    },
    {
      "id": "devcontainer-base",
      "kind": "image-lock",
      "lane": "issue",
      "detector": "devcontainer-base",
      "skill": "resolve-dependency-drift",
      "image": "mcr.microsoft.com/devcontainers/base",
      "lockPath": "containers/devcontainer-base/image.lock.json",
      "paths": [".devcontainer/Dockerfile"]
    },
    {
      "id": "production-node",
      "kind": "dockerfile-image",
      "lane": "issue",
      "detector": "node",
      "skill": "resolve-dependency-drift",
      "image": "docker.io/library/node",
      "paths": [
        "containers/app/Dockerfile",
        "containers/hsa-directory-mock/Dockerfile",
        "containers/hsa-person-lookup-adapter/Dockerfile",
        "containers/hsa-mtls-provisioner/Dockerfile",
        "containers/hsa-mtls-topology/Dockerfile"
      ]
    },
    {
      "id": "nginx",
      "kind": "image-lock",
      "lane": "issue",
      "detector": "nginx",
      "skill": "resolve-dependency-drift",
      "image": "docker.io/library/nginx",
      "lockPath": "containers/nginx/image.lock.json"
    },
    {
      "id": "sqlserver",
      "kind": "image-lock",
      "lane": "issue",
      "detector": "sqlserver",
      "skill": "resolve-dependency-drift",
      "image": "mcr.microsoft.com/mssql/server",
      "lockPath": "containers/sqlserver/image.lock.json"
    },
    {
      "id": "keycloak",
      "kind": "image-lock",
      "lane": "issue",
      "detector": "keycloak",
      "skill": "resolve-dependency-drift",
      "image": "quay.io/keycloak/keycloak",
      "lockPath": "containers/keycloak/image.lock.json"
    },
    {
      "id": "kong",
      "kind": "image-lock",
      "lane": "issue",
      "detector": "kong",
      "skill": "resolve-dependency-drift",
      "image": "docker.io/kong/kong-gateway",
      "lockPath": "containers/kong/image.lock.json"
    }
  ]
}
