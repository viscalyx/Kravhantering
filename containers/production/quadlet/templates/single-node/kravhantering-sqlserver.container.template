[Unit]
Description=Kravhantering SQL Server
PartOf=kravhantering-single-node.target
Requires=kravhantering-single-node-database-network.service kravhantering-sqlserver-data-volume.service
After=kravhantering-single-node-database-network.service kravhantering-sqlserver-data-volume.service

[Container]
ContainerName=kravhantering-sqlserver
Image=@@SQLSERVER_IMAGE_REF@@
EnvironmentFile=/etc/kravhantering/sqlserver.env
Environment=HOME=/var/opt/mssql
WorkingDir=/var/opt/mssql
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
PidsLimit=@@SQLSERVER_PIDS_LIMIT@@
LogDriver=journald
Network=kravhantering-single-node-database.network
PodmanArgs=--network-alias=sqlserver
PodmanArgs=--group-add=keep-groups
Volume=kravhantering-sqlserver-data.volume:/var/opt/mssql:U
Volume=@@BUNDLE_ROOT@@/sqlserver/mssql.conf:/var/opt/mssql/mssql.conf:ro
Volume=/etc/kravhantering/sqlserver-tls:/etc/kravhantering/sqlserver-tls:ro
Tmpfs=/.system:rw,size=16M,mode=0700,U,nosuid,nodev,noexec
Tmpfs=/tmp:rw,size=@@SQLSERVER_TMPFS_MIB@@M,mode=1777,U,nosuid,nodev,noexec

[Service]
Restart=always
TimeoutStartSec=180
TimeoutStopSec=90
MemoryMax=@@SQLSERVER_MEMORY_LIMIT_MIB@@M
CPUQuota=@@SQLSERVER_CPU_QUOTA_PERCENT@@%
TasksMax=@@SQLSERVER_TASKS_MAX@@
StandardOutput=journal
StandardError=journal
