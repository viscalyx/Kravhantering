[Unit]
Description=Kravhantering transient-state cleanup
PartOf=kravhantering-single-node.target
Requires=kravhantering-single-node-database-network.service kravhantering-single-node-egress-network.service kravhantering-sqlserver.service
After=kravhantering-single-node-database-network.service kravhantering-single-node-egress-network.service kravhantering-sqlserver.service

[Container]
ContainerName=kravhantering-transient-cleanup
Image=@@DB_JOB_IMAGE_REF@@
EnvironmentFile=/etc/kravhantering/app.env
Environment=NODE_EXTRA_CA_CERTS=/run/kravhantering/tls/ca.crt
Exec=/workspace/transient-cleanup/lib/transient-cleanup/cli.js
PodmanArgs=--entrypoint=/usr/local/bin/node
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
PidsLimit=128
LogDriver=journald
Network=kravhantering-single-node-database.network
Network=kravhantering-single-node-egress.network
Volume=/etc/kravhantering/tls/ca.crt:/run/kravhantering/tls/ca.crt:ro

[Service]
Type=oneshot
TimeoutStartSec=300
MemoryMax=512M
CPUQuota=100%
TasksMax=160
StandardOutput=journal
StandardError=journal
