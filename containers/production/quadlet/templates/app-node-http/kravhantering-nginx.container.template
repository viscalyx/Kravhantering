[Unit]
Description=Kravhantering nginx HTTP edge
PartOf=kravhantering-app-node.target
Requires=kravhantering-app-runtime.service
After=kravhantering-app-runtime.service

[Container]
ContainerName=kravhantering-nginx
Image=@@NGINX_IMAGE_REF@@
Environment=NGINX_RESOLVER=@@NGINX_RESOLVER@@
PublishPort=@@NGINX_HTTP_BIND@@:8080
Network=kravhantering-app-node.network
NetworkAlias=nginx
Volume=@@BUNDLE_ROOT@@/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=@@BUNDLE_ROOT@@/nginx/templates/app-node-http.conf.template:/etc/nginx/templates/default.conf.template:ro
Volume=@@BUNDLE_ROOT@@/nginx/templates/api-docs-security-headers.conf:/etc/nginx/snippets/api-docs-security-headers.conf:ro
Volume=@@BUNDLE_ROOT@@/nginx/templates/generated-output-locations.conf:/etc/nginx/snippets/generated-output-locations.conf:ro
Volume=@@BUNDLE_ROOT@@/api-docs:/usr/share/nginx/html/api-docs:ro

[Service]
Restart=always
TimeoutStartSec=180
TimeoutStopSec=90
