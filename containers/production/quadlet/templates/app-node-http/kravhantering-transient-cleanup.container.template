[Unit]
Description=Kravhantering transient-state cleanup
PartOf=kravhantering-app-node.target
Requires=kravhantering-app-node-egress-network.service
After=kravhantering-app-node-egress-network.service

[Container]
ContainerName=kravhantering-transient-cleanup
Image=@@DB_JOB_IMAGE_REF@@
EnvironmentFile=/etc/kravhantering/app.env
Exec=/workspace/transient-cleanup/lib/transient-cleanup/cli.js
PodmanArgs=--entrypoint=/usr/local/bin/node
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
PidsLimit=128
LogDriver=journald
Network=kravhantering-app-node-egress.network

[Service]
Type=oneshot
TimeoutStartSec=300
MemoryMax=512M
CPUQuota=100%
TasksMax=160
StandardOutput=journal
StandardError=journal
