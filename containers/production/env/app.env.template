NEXT_PUBLIC_SITE_URL=https://kravhantering.example.internal

# Server-proven deployment identity used by the opt-in staging-live gate.
# Production must never identify itself as staging. Use a stable opaque ID for
# this exact environment; staging operators configure their own distinct ID.
KRAVHANTERING_DEPLOYMENT_ENVIRONMENT=production
KRAVHANTERING_DEPLOYMENT_ENVIRONMENT_ID=production-primary

# Global release guard. Keep this active during installation, upgrade, restore,
# and rollback. Set to 0 only after the content-free AI deployment gate passes.
AI_REQUIREMENT_GENERATION_DISABLED=1
# Production must keep this staging-only, synthetic live-probe opt-in disabled.
AI_STAGING_LIVE_PROBE_ENABLED=0

# External versioned AES-256 root keyring. Provision this file independently;
# never store key bytes in this environment file.
AI_PROVIDER_SECRET_KEYRING_FILE=/run/secrets/kravhantering/ai-provider-secret-keyring.json

# Deployment-owned connection trust maps. Empty maps fail closed. Replace them
# with reviewed JSON before an administrator verifies or activates a
# connection. Follow docs/operations/ai-connection-deployment-policies.md.
AI_CONNECTION_EGRESS_POLICIES_JSON={}
AI_CONNECTION_DATA_POLICIES_JSON={}
AI_CONNECTION_TLS_POLICIES_JSON={}

# Optional absolute private spool root for generated CSV/PDF files. If unset or
# blank, the container operating-system temporary directory is used.
# When set, the existing directory must grant the non-root node operating-system
# account running Node.js read, write, and search (execute) access. Keep it
# private; app-owned mode 0700 satisfies this least-privilege requirement.
# KRAVHANTERING_EXPORT_TEMP_DIR=/absolute/private/spool/path

DB_ENCRYPT=true
DB_HOST=sqlserver.example.internal
DB_NAME=kravhantering
DB_PASSWORD=replace-with-app-db-password
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=false
DB_USER=kravhantering_app

# Scheduled transient-state cleanup bounds. Every SQL delete is capped by the
# batch size; one timer execution deletes at most the work limit across all
# registered targets and leaves at least the backlog target for each target.
TRANSIENT_CLEANUP_BACKLOG_TARGET=0
TRANSIENT_CLEANUP_BATCH_SIZE=100
TRANSIENT_CLEANUP_WORK_LIMIT=1000

AUTH_MCP_REQUIRED_SCOPES=kravhantering:mcp
AUTH_MCP_ROLES_CLAIM=roles
AUTH_MCP_TOKEN_MAX_AGE_SECONDS=300
AUTH_OIDC_API_AUDIENCE=kravhantering-app
AUTH_OIDC_CLIENT_ID=kravhantering-app
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_ISSUER_URL=https://idp.example.internal/realms/kravhantering
AUTH_OIDC_POST_LOGOUT_REDIRECT_URI=https://kravhantering.example.internal/
AUTH_OIDC_REDIRECT_URI=https://kravhantering.example.internal/api/auth/callback
AUTH_OIDC_ROLES_CLAIM=roles
AUTH_OIDC_SCOPES=openid profile email
AUTH_SESSION_COOKIE_NAME=kravhantering_session
AUTH_SESSION_COOKIE_PASSWORD=
AUTH_SESSION_TTL_SECONDS=28800
MCP_CLIENT_ID=kravhantering-mcp

HSA_PERSON_LOOKUP_TIMEOUT_MS=5000
# Production lookup, issuer, and token URLs must use HTTPS. OIDC discovery may
# only return a token endpoint on the configured issuer origin. Site-specific
# firewall, egress-proxy, DNS, route, and upstream ACL policy must allow only
# the approved destinations.
HSA_PERSON_LOOKUP_URL=https://kong.example.internal/hsa/person-records/lookup
# Optional app-to-external-integrationsplattform auth. Leave blank for the
# internal same-stack Kong route.
HSA_PERSON_LOOKUP_CA_PATH=
HSA_PERSON_LOOKUP_CLIENT_CERT_PATH=
HSA_PERSON_LOOKUP_CLIENT_KEY_PATH=
HSA_PERSON_LOOKUP_TLS_SERVER_NAME=
HSA_PERSON_LOOKUP_OAUTH_TOKEN_URL=
HSA_PERSON_LOOKUP_OAUTH_ISSUER_URL=
HSA_PERSON_LOOKUP_OAUTH_CLIENT_ID=
HSA_PERSON_LOOKUP_OAUTH_CLIENT_SECRET=
HSA_PERSON_LOOKUP_OAUTH_SCOPE=
HSA_PERSON_LOOKUP_OAUTH_AUDIENCE=
