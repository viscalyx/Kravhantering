# Site-specific image references. Use tag-style refs by default, either refs
# that this host can pull or refs that the image helper should create after
# podman load. Prefer release-specific internal mirror tags for third-party
# images so moving public tags such as stable-alpine or 2025-latest cannot
# drift after release. On disconnected hosts, the registry hostname may be a
# non-resolvable local/fake name; Podman only needs a local tag for later
# Quadlet startup. Do not run podman pull for non-resolvable disconnected
# refs. Run
# bin/kravhantering-images.sh verify before starting the stack.
APP_RUNTIME_IMAGE_REF=registry.example.internal/kravhantering-app-runtime:replace-with-release-tag
DB_JOB_IMAGE_REF=registry.example.internal/kravhantering-db-job:replace-with-release-tag
NGINX_IMAGE_REF=registry.example.internal/nginx:replace-with-release-nginx-tag
SQLSERVER_IMAGE_REF=registry.example.internal/mssql/server:replace-with-release-sqlserver-tag
KEYCLOAK_IMAGE_REF=registry.example.internal/keycloak/keycloak:replace-with-release-keycloak-tag

# Opt-in only when approved to pull public upstream registries directly.
# Use image:tag values derived from container-stack.lock.json and verify
# immediately because public tags can be republished. The image helper also
# accepts image:tag@sha256:digest refs when a site explicitly requires
# pull-time digest pinning.
# APP_RUNTIME_IMAGE_REF=ghcr.io/viscalyx/kravhantering-app-runtime:replace-with-release-tag
# DB_JOB_IMAGE_REF=ghcr.io/viscalyx/kravhantering-db-job:replace-with-release-tag
# NGINX_IMAGE_REF=docker.io/library/nginx:1.31.3-alpine
# SQLSERVER_IMAGE_REF=mcr.microsoft.com/mssql/server:2025-CU7-ubuntu-24.04
# KEYCLOAK_IMAGE_REF=quay.io/keycloak/keycloak:26.7.0-1

# Test-only single-node-demo refs. Production Quadlet topologies ignore these;
# leave them as site-specific tag refs when the demo/test topology is unused.
KONG_IMAGE_REF=registry.example.internal/kong/kong-gateway:replace-with-release-kong-tag
HSA_DIRECTORY_MOCK_IMAGE_REF=registry.example.internal/kravhantering-hsa-directory-mock:replace-with-release-tag
HSA_PERSON_LOOKUP_ADAPTER_IMAGE_REF=registry.example.internal/kravhantering-hsa-person-lookup-adapter:replace-with-release-tag

# Public direct-pull examples for the test-only single-node-demo topology.
# KONG_IMAGE_REF=docker.io/kong/kong-gateway:3.15.0.2-20260721-ubuntu
# HSA_DIRECTORY_MOCK_IMAGE_REF=ghcr.io/viscalyx/kravhantering-hsa-directory-mock:replace-with-release-tag
# HSA_PERSON_LOOKUP_ADAPTER_IMAGE_REF=ghcr.io/viscalyx/kravhantering-hsa-person-lookup-adapter:replace-with-release-tag

# Public DNS name for the app without https://. In the self-contained
# single-node topology, set this to the same host used by NEXT_PUBLIC_SITE_URL,
# KC_HOSTNAME, redirect URIs and the TLS certificate SAN.
PUBLIC_HOSTNAME=kravhantering.example.internal

# Used by the TLS-on-node Quadlet topologies. Binding 443 from a rootless container
# requires a host sysctl described in the production deployment guide.
NGINX_HTTPS_BIND=443:443

# Podman edge-network DNS resolver used by nginx for dynamic app-runtime lookups.
# 10.89.0.1 is the common rootless Podman default, not a fixed requirement.
# If the deployment network is renamed, recreated or assigned another subnet,
# set this to the first nameserver from inside a container attached to the same
# Quadlet network before starting nginx.
NGINX_RESOLVER=10.89.0.1

# Only used by the single-node topology. Podman DNS is network-scoped, so nginx
# needs the identity-network resolver for dynamic Keycloak lookups.
NGINX_IDENTITY_RESOLVER=10.89.1.1

# Only used by the app-node-http Quadlet topology.
NGINX_HTTP_BIND=127.0.0.1:8080

# Stateless service containment. Values are decimal integers; the helper adds
# units and rejects values outside the documented production envelope.
APP_RUNTIME_MEMORY_LIMIT_MIB=4096
APP_RUNTIME_CPU_QUOTA_PERCENT=300
APP_RUNTIME_PIDS_LIMIT=512
APP_RUNTIME_EXPORT_STORAGE=tmpfs
APP_RUNTIME_EXPORT_TMPFS_MIB=1024
# APP_RUNTIME_EXPORT_HOST_PATH=/srv/kravhantering/export
NGINX_MEMORY_LIMIT_MIB=512
NGINX_CPU_QUOTA_PERCENT=100
NGINX_PIDS_LIMIT=128
NGINX_CACHE_TMPFS_MIB=64

# Stateful service containment for the single-node topology. SQL Server's
# 4 GiB memory default stays above the vendor's 2 GiB startup minimum. Tmpfs
# values bound container-local /tmp and Keycloak's generated Quarkus output;
# durable state remains in the named volumes.
SQLSERVER_MEMORY_LIMIT_MIB=4096
SQLSERVER_CPU_QUOTA_PERCENT=200
SQLSERVER_PIDS_LIMIT=1024
SQLSERVER_TMPFS_MIB=512
KEYCLOAK_MEMORY_LIMIT_MIB=3072
KEYCLOAK_CPU_QUOTA_PERCENT=100
KEYCLOAK_PIDS_LIMIT=512
KEYCLOAK_QUARKUS_TMPFS_MIB=64
KEYCLOAK_TMPFS_MIB=512
