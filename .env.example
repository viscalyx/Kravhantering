# Example environment variables
# Copy this to .env.development.local for local overrides/secrets
#
# Next.js loads matching `.env*` files automatically. Repo helper scripts also
# read the same file set for local database commands, with the more specific
# files overriding the less specific ones:
#   .env
#   .env.<environment>
#   .env.local
#   .env.<environment>.local
#
# The prod-like local workflow uses .env.prodlike (loaded via dotenv-cli)
# instead of .env.production, which is reserved for the deployment secret store.

# Only .env.local and .env.*.local files should contain secrets.
# All other .env files are committed to share configuration across contributors.

# Public variables (exposed to browser) must be prefixed with NEXT_PUBLIC_
# Example: NEXT_PUBLIC_API_URL=https://api.example.com

# Private variables (server-side only) have no prefix
# Example: DATABASE_URL=mssql://sa:YourStrong!Passw0rd@127.0.0.1:1433/kravhantering?encrypt=true&trustServerCertificate=true
# Example: API_SECRET_KEY=your-secret-here

# --------------------------------------
# Project-specific local development vars
# --------------------------------------

# Canonical site URL used by metadata, sitemap, and readiness checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional absolute private spool root for generated CSV/PDF files. If unset or
# blank, the operating-system temporary directory is used.
# When set, the existing directory must grant the non-root operating-system
# account running Node.js read, write, and search (execute) access. Keep it
# private; app-owned mode 0700 satisfies this least-privilege requirement.
# KRAVHANTERING_EXPORT_TEMP_DIR=/absolute/private/spool/path

# HSA directory person lookup. In the devcontainer, Kong is internal on the
# compose network and proxies this REST path to the HSA directory mock.
# Strict App-to-Kong mTLS tuple. All values are mandatory when the URL is set.
HSA_PERSON_LOOKUP_CA_PATH=/run/kravhantering/hsa-mtls/kong-server-ca.crt
HSA_PERSON_LOOKUP_CLIENT_CERT_PATH=/run/kravhantering/hsa-mtls/app-client.crt
HSA_PERSON_LOOKUP_CLIENT_KEY_PATH=/run/kravhantering/hsa-mtls/app-client.key
HSA_PERSON_LOOKUP_TIMEOUT_MS=5000
HSA_PERSON_LOOKUP_TLS_SERVER_NAME=kong
HSA_PERSON_LOOKUP_URL=https://kong:8443/hsa/person-records/lookup
# HSA_PERSON_LOOKUP_OAUTH_TOKEN_URL=
# HSA_PERSON_LOOKUP_OAUTH_ISSUER_URL=
# OAuth CA trust must not contain the App-to-Kong CA above.
# HSA_PERSON_LOOKUP_OAUTH_CA_PATH=
# HSA_PERSON_LOOKUP_OAUTH_CLIENT_ID=
# HSA_PERSON_LOOKUP_OAUTH_CLIENT_SECRET=
# HSA_PERSON_LOOKUP_OAUTH_SCOPE=
# HSA_PERSON_LOOKUP_OAUTH_AUDIENCE=

# SQL Server config for TypeORM.
# Use either an explicit connection string or the derived DB_* settings used in
# `.env.sqlserver.example` and `.devcontainer/.env.example`.
# Host-side runs typically use `127.0.0.1`; inside the devcontainer, `DB_HOST=db`
# comes from `.devcontainer/.env`.
# Example explicit write connection string:
DATABASE_URL=mssql://sa:YourStrong!Passw0rd@127.0.0.1:1433/kravhantering?encrypt=true&trustServerCertificate=true
# Optional explicit read-only browse connection string:
# DATABASE_READONLY_URL=mssql://readonly:BrowseOnly!Passw0rd7@127.0.0.1:1433/kravhantering?encrypt=true&trustServerCertificate=true
# Example derived settings instead of DATABASE_URL:
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_NAME=kravhantering
# MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# DB_READONLY_USER=readonly
# DB_READONLY_PASSWORD=BrowseOnly!Passw0rd7
# DB_RUNTIME_USER=kravhantering_app
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true

# --------------------------------------
# AI connections
# --------------------------------------

# External versioned AES-256 root keyring. The local provisioning helper
# creates the ignored default file without printing or overwriting key bytes.
AI_PROVIDER_SECRET_KEYRING_FILE=.local/ai-provider-secret-keyring.json

# Deployment-owned AI connection trust policy. These maps are configuration,
# not provider secrets. Keep origins exact and generate the network egress
# allowlist from the same reviewed source. The built-in production transport
# currently supports public Web PKI; private-CA policies require a separately
# composed deployment transport. See the step-by-step operator guide:
# docs/operations/ai-connection-deployment-policies.md
AI_CONNECTION_DATA_POLICIES_JSON={}
AI_CONNECTION_EGRESS_POLICIES_JSON={}
AI_CONNECTION_TLS_POLICIES_JSON={}
# Development only: the exact origin permitted to use authentication type
# `none`. It is ignored as an exception in test and production environments.
# AI_CONNECTION_DEVELOPMENT_LOCAL_ORIGIN=https://ai.example.test

# --------------------------------------
# Authentication (PhenixID OIDC)
# --------------------------------------
# See docs/development/auth-developer-workflow.md for the full setup guide.
#
# Authentication is mandatory in every build target.
# Boot fails closed if any of the OIDC settings below are missing.

# Required when MCP is enabled. Space-separated OAuth scopes; every configured
# scope must be present in each MCP service token.
AUTH_MCP_REQUIRED_SCOPES=kravhantering:mcp
# Optional. Defaults shown.
AUTH_MCP_ROLES_CLAIM=roles
AUTH_MCP_TOKEN_MAX_AGE_SECONDS=300

AUTH_OIDC_CLIENT_ID=kravhantering-app
AUTH_OIDC_CLIENT_SECRET=dev-only-app-secret
# OIDC issuer base URL (used for discovery at <ISSUER>/.well-known/openid-configuration).
# Local Keycloak default: http://localhost:8080/realms/kravhantering-dev
AUTH_OIDC_ISSUER_URL=http://localhost:8080/realms/kravhantering-dev

AUTH_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# Full callback URL, must be pre-registered with the IdP.
AUTH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Audience expected on access tokens (MCP). Defaults to AUTH_OIDC_CLIENT_ID.
AUTH_OIDC_API_AUDIENCE=
AUTH_OIDC_ROLES_CLAIM=roles
# Optional. Defaults shown.
AUTH_OIDC_SCOPES="openid profile email"
# OAuth client id of the calling MCP service client. Setting this enables the
# MCP server; leaving it empty disables the MCP endpoint.
MCP_CLIENT_ID=kravhantering-mcp

AUTH_SESSION_COOKIE_NAME=kravhantering_session
# Iron-session encryption password. MUST be at least 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SESSION_COOKIE_PASSWORD=replace-with-32-bytes-of-randomness-XXXXXXXX
AUTH_SESSION_TTL_SECONDS=28800
